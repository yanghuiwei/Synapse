    "react-resizable-panels": "^4.12.4",
    "uplot": "^1.6.32",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
